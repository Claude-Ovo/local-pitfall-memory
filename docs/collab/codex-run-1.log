 154:     if rows:
 155:         pid = rows[0][0]; res = _resolution_for(conn, pid); hits = _hits(conn, pid)
 156:         out({"hit": "family", "confidence": "需谨慎", "pitfall_id": pid,
 157:              "family_size": len(rows), "times_seen": hits[0], "last_seen": hits[1],
 158:              "family_hint": "same error class/package, different details — verify before applying",
 159:              "known_variant": redact(rows[0][1]), "resolution": res}, args.json)
 160:         return 0
 161: 
 162:     # 3) semantic: FTS5 BM25 over normalized text → 仅联想
 163:     tokens = re.findall(r"[A-Za-z0-9_]{3,}", feat["semantic_text"])[:20]
 164:     q = " OR ".join(f'"{t}"' for t in tokens)
 165:     if q:
 166:         rows = conn.execute(
 167:             "SELECT rowid FROM pitfall_fts WHERE pitfall_fts MATCH ? ORDER BY bm25(pitfall_fts) LIMIT 3",
 168:             (q,)).fetchall()
 169:         if rows:
 170:             pid = rows[0][0]
 171:             out({"hit": "semantic", "confidence": "仅联想", "pitfall_id": pid,
 172:                  "resolution": _resolution_for(conn, pid)}, args.json)
 173:             return 0
 174:     out({"hit": "none", "confidence": None, "note": "no local history; solve fresh then propose+commit"}, args.json)
 175:     return 0
 176: 
 177: def cmd_propose(args):
 178:     req = _load_request(args)
 179:     ctx = req.get("context", {})
 180:     feat = extract(req["error_text"], ctx.get("runtime", ""))
 181:     now = int(time.time())
 182:     conn = db()
 183:     row = conn.execute("SELECT id FROM pitfalls WHERE exact_fp=?", (feat["exact_fp"],)).fetchone()
 184:     if row:
 185:         pid = row[0]
 186:     else:
 187:         cur = conn.execute(
 188:             "INSERT INTO pitfalls(exact_fp,family_fp,runtime,error_class,package,norm_tail,created_at) "
 189:             "VALUES(?,?,?,?,?,?,?)",
 190:             (feat["exact_fp"], feat["family_fp"], feat["runtime"], feat["error_class"],
 191:              feat["package"], feat["norm_tail"], now))
 192:         pid = cur.lastrowid
 193:         conn.execute("INSERT INTO pitfall_fts(rowid,semantic_text) VALUES(?,?)", (pid, feat["semantic_text"]))
 194:     # everything stored is redacted at write time — the DB never holds secrets, emails or public IPs
 195:     conn.execute("INSERT INTO occurrences(pitfall_id,cwd,raw_head,seen_at) VALUES(?,?,?,?)",
 196:                  (pid, redact(ctx.get("cwd", "")), redact(req["error_text"][:500]), now))
 197:     cur = conn.execute(
 198:         "INSERT INTO resolutions(pitfall_id,root_cause,fix_command,verify_method,verified,created_at) "
 199:         "VALUES(?,?,?,?,0,?)",
 200:         (pid, redact(req.get("root_cause", "")), redact(req.get("fix_command", "")),
 201:          redact(req.get("verify_method", "")), now))
 202:     conn.commit()
 203:     out({"ok": True, "pitfall_id": pid, "proposal_id": cur.lastrowid,
 204:          "state": "proposed (unverified) — run commit after the fix is verified"}, args.json)
 205:     return 0
 206: 
 207: def cmd_commit(args):
 208:     conn = db()
 209:     if int(args.verify_exit_code) != 0:
 210:         out({"ok": False, "note": "verification failed; proposal stays unverified"}, args.json)
 211:         return 1
 212:     n = conn.execute("UPDATE resolutions SET verified=1, verified_at=? WHERE id=?",
 213:                      (int(time.time()), args.id)).rowcount
 214:     conn.commit()
 215:     out({"ok": bool(n), "resolution_id": args.id, "state": "verified"}, args.json)
 216:     return 0 if n else 1
 217: 
 218: def cmd_digest(args):
 219:     conn = db()
 220:     rows = conn.execute(
 221:         "SELECT p.error_class,p.package,p.norm_tail,r.root_cause,r.fix_command,"
 222:         "(SELECT COUNT(*) FROM occurrences o WHERE o.pitfall_id=p.id) "
 223:         "FROM pitfalls p JOIN resolutions r ON r.pitfall_id=p.id AND r.verified=1 "
 224:         "ORDER BY 6 DESC").fetchall()
 225:     lines = ["# Pitfalls we hit (verified fixes only)", "",
 226:              "| Error | Package | Root cause | Fix | Times |", "|---|---|---|---|---|"]
 227:     for ec, pkg, tail, cause, fix, cnt in rows:
 228:         cell = lambda s: (s or "").replace("|", "\\|").replace("\n", " ")[:120]
 229:         lines.append(f"| {cell(ec) or cell(tail)} | {cell(pkg)} | {cell(cause)} | `{cell(fix)}` | {cnt} |")
 230:     text = "\n".join(lines) + "\n"
 231:     if args.out:
 232:         Path(args.out).write_text(text, encoding="utf-8")
 233:         out({"ok": True, "out": args.out, "verified_entries": len(rows)}, True)
 234:     else:
 235:         print(text)
 236:     return 0
 237: 
 238: def main():
 239:     p = argparse.ArgumentParser(prog="local-pitfall-memory")
 240:     sub = p.add_subparsers(dest="cmd", required=True)
 241:     for name in ("status",):
 242:         s = sub.add_parser(name); s.add_argument("--json", action="store_true")
 243:     for name in ("lookup", "propose"):
 244:         s = sub.add_parser(name)
 245:         s.add_argument("--request-file", required=True)
 246:         s.add_argument("--json", action="store_true")
 247:     s = sub.add_parser("commit")
 248:     s.add_argument("--id", required=True)
 249:     s.add_argument("--verify-exit-code", required=True)
 250:     s.add_argument("--json", action="store_true")
 251:     s = sub.add_parser("digest")
 252:     s.add_argument("--out")
 253:     s.add_argument("--json", action="store_true")
 254:     args = p.parse_args()
 255:     return {"status": cmd_status, "lookup": cmd_lookup, "propose": cmd_propose,
 256:             "commit": cmd_commit, "digest": cmd_digest}[args.cmd](args)
 257: 
 258: if __name__ == "__main__":
 259:     sys.exit(main())


  59: PKG_RE = re.compile(r"(?:node_modules[\\/](@?[\w.-]+(?:[\\/][\w.-]+)?)|site-packages[\\/]([\w.-]+)|from ['\"]([^'\"]+)['\"]|package ([\w.-]+))")
  60: 
  61: def normalize(text: str) -> str:
  62:     for pat, rep in STRIP_PATTERNS:
  63:         text = pat.sub(rep, text)
  64:     return text.strip()
  65: 
  66: FRAME_RE = re.compile(r"\s*(at |File \"|--> |#\d+ )")
  67: 
  68: def extract(text: str, runtime: str = ""):
  69:     norm = normalize(text)
  70:     lines = [l for l in norm.splitlines() if l.strip()]
  71:     frames = [l.strip()[:200] for l in lines if FRAME_RE.match(l)][:3]
  72:     msg_lines = [l for l in lines if not FRAME_RE.match(l)]
  73:     # "tail" = the message line, never a stack frame. Prefer the line that names the error class
  74:     # (Node prints it after a source excerpt: "loader:1958 / throw err; / ^ / Error [X]: ...").
  75:     m = ERROR_CLASS_RE.search(norm)
  76:     error_class = m.group(1) if m else ""
  77:     tail = ""
  78:     if error_class:
  79:         tail = next((l for l in reversed(msg_lines) if error_class in l), "")
  80:     if not tail:
  81:         tail = msg_lines[-1] if msg_lines else (lines[-1] if lines else "")
  82:     tail = tail.strip()[:300]
  83:     pm = PKG_RE.search(text)
  84:     package = next((g for g in (pm.groups() if pm else ()) if g), "")
  85:     exact_src = "|".join([runtime, error_class, tail] + frames + [package])
  86:     family_src = "|".join([error_class, package, re.sub(r"['\"][^'\"]*['\"]", "<S>", tail)])
  87:     return {
  88:         "runtime": runtime, "error_class": error_class, "package": package,
  89:         "norm_tail": tail,
  90:         "exact_fp": hashlib.sha256(exact_src.encode()).hexdigest()[:24],
  91:         "family_fp": hashlib.sha256(family_src.encode()).hexdigest()[:24],
  92:         "semantic_text": " ".join([error_class, package, tail] + frames)[:1000],
  93:     }
  94: 
  95: # ---- db ----------------------------------------------------------------------
  96: def db():
  97:     DB_PATH.parent.mkdir(parents=True, exist_ok=True)
  98:     conn = sqlite3.connect(DB_PATH)
  99:     conn.executescript(SCHEMA)
 100:     return conn
 101: 
 102: def out(obj, as_json):
 103:     print(json.dumps(obj, ensure_ascii=False, indent=None if as_json else 2))
 104: 
 105: # ---- commands ----------------------------------------------------------------
 106: def cmd_status(args):
 107:     conn = db()
 108:     n = {t: conn.execute(f"SELECT COUNT(*) FROM {t}").fetchone()[0]
 109:          for t in ("pitfalls", "occurrences", "resolutions")}
 110:     verified = conn.execute("SELECT COUNT(*) FROM resolutions WHERE verified=1").fetchone()[0]
 111:     fts_ok = bool(conn.execute("SELECT 1 FROM sqlite_master WHERE name='pitfall_fts'").fetchone())
 112:     model_ready = (MODEL_DIR / "openvino_model.bin").exists() and (MODEL_DIR / "openvino_model.xml").exists()
 113:     out({"ok": True, "db": redact(str(DB_PATH)), "pitfalls": n["pitfalls"],
 114:          "occurrences": n["occurrences"], "resolutions": n["resolutions"],
 115:          "verified_resolutions": verified, "fts5": fts_ok,
 116:          "model_ready": model_ready, "redaction": "on", "version": VERSION}, args.json)
 117:     return 0
 118: 
 119: def _load_request(args):
 120:     with open(args.request_file, encoding="utf-8") as f:
 121:         return json.load(f)
 122: 
 123: def _resolution_for(conn, pid):
 124:     r = conn.execute(
 125:         "SELECT root_cause,fix_command,verify_method,verified FROM resolutions "
 126:         "WHERE pitfall_id=? ORDER BY verified DESC, created_at DESC LIMIT 1", (pid,)).fetchone()
 127:     if not r:
 128:         return None
 129:     return redact_card({"root_cause": r[0], "fix_command": r[1], "verify_method": r[2], "verified": bool(r[3])})
 130: 
 131: def _hits(conn, pid):
 132:     return conn.execute("SELECT COUNT(*),MAX(seen_at) FROM occurrences WHERE pitfall_id=?", (pid,)).fetchone()
 133: 
 134: def cmd_lookup(args):
 135:     req = _load_request(args)
 136:     ctx = req.get("context", {})
 137:     feat = extract(req["error_text"], ctx.get("runtime", ""))
 138:     conn = db()
 139: 
 140:     # 1) exact: same fingerprint → 可引用 only if a verified resolution exists
 141:     row = conn.execute("SELECT id FROM pitfalls WHERE exact_fp=?", (feat["exact_fp"],)).fetchone()
 142:     if row:
 143:         pid = row[0]; res = _resolution_for(conn, pid); hits = _hits(conn, pid)
 144:         conf = "可引用" if (res and res["verified"]) else "需谨慎"
 145:         out({"hit": "exact", "confidence": conf, "pitfall_id": pid,
 146:              "times_seen": hits[0], "last_seen": hits[1], "resolution": res}, args.json)
 147:         return 0
 148: 
 149:     # 2) family: same error class + package + message template, but details differ.
 150:     #    Never 可引用 — the Host must re-verify before applying.
 151:     rows = conn.execute(
 152:         "SELECT id, norm_tail FROM pitfalls WHERE family_fp=? ORDER BY created_at DESC LIMIT 3",
